{
  "name": "pokeshell-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time top-down Pokemon battles with the cards you pulled in pokeshell",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "node tools/shots.mjs",
    "probe:stuck": "vite-node tools/movement/stuck.ts",
    "shots:overlay": "node tools/movement/shots.mjs",
    "packs:demo": "node scripts/packs-demo.mjs",
    "kits:build": "vite-node tools/kits/build.ts",
    "kits:coverage": "vite-node tools/kits/coverage.ts",
    "kits:tournament": "node tools/kits/run.mjs",
    "kits:shots": "node tools/kits/kitshots.mjs",
    "release:data": "node tools/release/bundle.mjs",
    "release:win": "node tools/release/build.mjs win",
    "release:mac": "node tools/release/build.mjs mac",
    "release:fixture": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/odds-fixture.ps1",
    "test:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/test-standalone.ps1 && node tests/standalone-ui.mjs",
    "release:art": "node tools/release/bundle.mjs --art-pak"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "happy-dom": "^18.0.1",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
